# Native Linux deployment for Nginx + PHP-FPM + MySQL 8.0. Keep mode 0600.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gojet
MYSQL_USER=gojet
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=replace-with-the-existing-mysql-root-password
MYSQL_DSN="gojet:replace-with-a-long-random-password@tcp(127.0.0.1:3306)/gojet?parseTime=true&charset=utf8mb4"
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=replace-with-the-existing-redis-password
SETTINGS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-admin-password
PUBLIC_BASE_URL=https://go.example.com
VISITOR_HASH_KEY=replace-with-at-least-32-random-characters
QR_TRACKING_KEY=replace-with-a-different-32-character-random-secret
LOG_INGEST_TOKEN=replace-with-random-log-ingest-token
LOG_WEBHOOK_TOKEN=replace-with-random-log-ingest-token
LOG_WEBHOOK_URL=http://127.0.0.1:18092/v1/logs
PLATFORM_HTTP_ADDRESS=127.0.0.1:18090
HTTP_ADDRESS=127.0.0.1:18080
LOG_RECEIVER_HTTP_ADDRESS=127.0.0.1:18092
UPLOAD_STORAGE_PATH=__GOJET_ROOT__/deploy/data/uploads
FILE_STORAGE_PATH=__GOJET_ROOT__/deploy/data/files
FILE_STORAGE_DRIVER=filesystem
CLAMAV_ADDRESS=127.0.0.1:3310
ANALYTICS_GROUP=gojet-mysql
ANALYTICS_CONSUMER=native-worker-1
ANALYTICS_BATCH_SIZE=100
ANALYTICS_RECONCILE_BATCH=500
ANALYTICS_RECONCILE_INTERVAL_SECONDS=60
OPERATIONS_MONITOR_INTERVAL_SECONDS=60
ALERT_RECIPIENT=ops@example.com
