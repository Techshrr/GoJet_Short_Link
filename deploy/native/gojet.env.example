# Native Linux deployment for aaPanel/Nginx + PHP 8.3 + MySQL 8.x. Keep mode 0600.
# MySQL database and regular user are created by the operator in aaPanel before installation.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gojet
MYSQL_USER=gojet
MYSQL_PASSWORD=replace-with-the-database-user-password
MYSQL_DSN="gojet:replace-with-the-database-user-password@tcp(127.0.0.1:3306)/gojet?parseTime=true&charset=utf8mb4"
# Local/loopback Redis may run without authentication. Remote Redis must use
# password authentication or ACL username + password.
REDIS_ADDRESS=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
SETTINGS_ENCRYPTION_KEY=generated-by-installer
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-initial-admin-password
PUBLIC_BASE_URL=https://go.example.com
VISITOR_HASH_KEY=generated-by-installer
QR_TRACKING_KEY=generated-by-installer
LOG_INGEST_TOKEN=generated-by-installer
LOG_WEBHOOK_TOKEN=generated-by-installer
LOG_WEBHOOK_URL=http://127.0.0.1:18092/v1/logs
PLATFORM_HTTP_ADDRESS=127.0.0.1:18090
HTTP_ADDRESS=127.0.0.1:18080
LOG_RECEIVER_HTTP_ADDRESS=127.0.0.1:18092
UPLOAD_STORAGE_PATH=__GOJET_ROOT__/deploy/data/uploads
BRAND_ASSET_PATH=__GOJET_ROOT__/deploy/data/brand
GENERATED_QR_STORAGE_PATH=__GOJET_ROOT__/deploy/data/generated/qr
FILE_STORAGE_PATH=__GOJET_ROOT__/deploy/data/files
# P21 ships the pinned static TrueType font used by the Go PDF renderer.
PDF_FONT_PATH=__GOJET_ROOT__/resources/fonts/NotoSansSCRegular.ttf
FILE_STORAGE_DRIVER=filesystem
# Native Debian/aaPanel uses the local Unix socket. Set disabled if ClamAV is unavailable.
CLAMAV_ADDRESS=unix:///run/clamav/clamd.ctl
ANALYTICS_GROUP=gojet-mysql
ANALYTICS_CONSUMER=native-worker-1
ANALYTICS_BATCH_SIZE=100
ANALYTICS_RECONCILE_BATCH=500
ANALYTICS_RECONCILE_INTERVAL_SECONDS=60
OPERATIONS_MONITOR_INTERVAL_SECONDS=60
ALERT_RECIPIENT=ops@example.com
# The built-in semantic destination-risk provider is always active. These
# controls tune the worker and optionally add an external HTTPS reputation
# provider without replacing or disabling GoJet's generic semantic checks.
DESTINATION_RISK_SCAN_INTERVAL_SECONDS=3
DESTINATION_RISK_SCAN_WORKERS=4
DESTINATION_RISK_SCAN_BATCH=24
DESTINATION_RISK_PROVIDER_URL=
DESTINATION_RISK_PROVIDER_TOKEN=
