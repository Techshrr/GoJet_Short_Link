[Unit]
Description=GoJet %i
Wants=network-online.target
After=network-online.target mysql.service mysqld.service redis.service redis-server.service

[Service]
Type=simple
User=gojet
Group=gojet
WorkingDirectory=__GOJET_ROOT__
EnvironmentFile=__GOJET_ROOT__/deploy/native/gojet.env
Environment=BRAND_ASSET_PATH=__GOJET_ROOT__/deploy/data/brand
Environment=GENERATED_QR_STORAGE_PATH=__GOJET_ROOT__/deploy/data/generated/qr
Environment=GEOIP_MMDB=__GOJET_ROOT__/deploy/data/geoip/GeoLite2-City.mmdb
Environment=GEOIP_COUNTRY_CSV=__GOJET_ROOT__/deploy/data/geoip/country.csv
Environment=PDF_FONT_PATH=__GOJET_ROOT__/resources/fonts/NotoSansSCRegular.ttf
UMask=0022
ExecStartPre=/usr/bin/mkdir -p __GOJET_ROOT__/deploy/data/brand __GOJET_ROOT__/deploy/data/generated/qr __GOJET_ROOT__/deploy/data/geoip
ExecStartPre=/usr/bin/test -s __GOJET_ROOT__/resources/fonts/NotoSansSCRegular.ttf
ExecStartPre=/usr/bin/chmod 0755 __GOJET_ROOT__/deploy/data/brand __GOJET_ROOT__/deploy/data/generated/qr __GOJET_ROOT__/deploy/data/geoip
ExecStart=__GOJET_ROOT__/bin/%i
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__GOJET_ROOT__/deploy/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
