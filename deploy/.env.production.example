# Copy to deploy/.env.production, chmod 600, and replace every placeholder.
HTTP_PORT=80
# container: bundled Nginx; host: system Nginx with install-host-nginx.sh
NGINX_MODE=container
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
VISITOR_HASH_KEY=replace-with-at-least-32-random-characters
QR_TRACKING_KEY=replace-with-a-different-32-character-random-secret
VISIT_RATE_LIMIT_PER_MINUTE=60
ANALYTICS_BATCH_SIZE=100
ANALYTICS_RECONCILE_BATCH=500
ANALYTICS_RECONCILE_INTERVAL_SECONDS=60
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-admin-password
PUBLIC_BASE_URL=https://go.example.com
FILE_MAX_UPLOAD_MB=100
ALERT_RECIPIENT=ops@example.com
OPERATIONS_MONITOR_INTERVAL_SECONDS=60
# filesystem is self-contained; use s3 only after filling every S3 field below.
FILE_STORAGE_DRIVER=filesystem
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_SECURE=true
# These two values must be identical.
LOG_WEBHOOK_URL=http://log-receiver:8092/v1/logs
LOG_WEBHOOK_TOKEN=replace-with-random-log-ingest-token
LOG_INGEST_TOKEN=replace-with-random-log-ingest-token
