HTTP_PORT=80
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
VISITOR_HASH_KEY=replace-with-at-least-32-random-characters
QR_TRACKING_KEY=replace-with-a-different-32-character-random-secret
VISIT_RATE_LIMIT_PER_MINUTE=60
ANALYTICS_BATCH_SIZE=100
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
PUBLIC_BASE_URL=https://go.example.com
FILE_MAX_UPLOAD_MB=100
