APP_NAME=GoJet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gojet
DB_USERNAME=gojet
DB_PASSWORD=

# File sessions allow the browser installer to run before MySQL/Redis are configured.
# The installer changes sessions, cache, and queues to Redis after validation.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PREFIX=gojet-database-
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=smtp
MAIL_AUTO_TLS=true
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

GOJET_INSTALLED=false
GOJET_ADMIN_PATH=manage
GOJET_SUPPORT_EMAIL=support@example.com
GOJET_DEFAULT_HOST=localhost
GOJET_SHORT_CODE_LENGTH=7
GOJET_REDIRECT_TYPE=302
GOJET_ALLOW_REGISTRATION=true
GOJET_REQUIRE_EMAIL_VERIFICATION=true
GOJET_ALLOW_ANONYMOUS=false
GOJET_LINK_CACHE_TTL=3600
GOJET_CLICK_RETENTION_DAYS=90
GOJET_IP_HASH_KEY=
GOJET_BLOCK_PRIVATE_TARGETS=true
GOJET_DOMAIN_VERIFICATION_PREFIX=_gojet-verification
GOJET_CLOUDFLARE_ENABLED=false
GOJET_CLOUDFLARE_API_TOKEN=
GOJET_CLOUDFLARE_ZONE_ID=
GOJET_CLOUDFLARE_CUSTOM_HOSTNAME_FALLBACK_ORIGIN=
# Go Redirect Plane / durable analytics spool
GOJET_REDIRECT_PLANE_ENABLED=true
GOJET_REDIRECT_INTERNAL_TOKEN=change-me-with-a-long-random-secret
GOJET_REDIRECT_INTERNAL_URL=http://127.0.0.1
GOJET_CONTROL_PLANE_URL=http://127.0.0.1
GOJET_REDIRECT_HEALTH_URL=http://127.0.0.1:8081/healthz
GOJET_REDIRECT_CACHE_TTL_SECONDS=3600
GOJET_REDIRECT_SPOOL_DIR=/var/lib/gojet/spool
GOJET_ANALYTICS_ENABLED=true
GOJET_ANALYTICS_STORE_REFERRER_URL=true
