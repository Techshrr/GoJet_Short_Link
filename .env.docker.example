APP_NAME=GoJet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gojet.cc
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gojet
DB_USERNAME=gojet
DB_PASSWORD=replace-with-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-long-random-redis-password
REDIS_DB=0
REDIS_CACHE_DB=1

# Configure a working SMTP service before enabling GOJET_REQUIRE_EMAIL_VERIFICATION.
MAIL_MAILER=log
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_AUTO_TLS=true
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=noreply@gojet.cc
MAIL_FROM_NAME=GoJet

GOJET_INSTALLED=true
GOJET_ADMIN_PATH=manage-change-this
GOJET_SUPPORT_EMAIL=support@gojet.cc
GOJET_DEFAULT_HOST=gojet.cc
GOJET_SHORT_CODE_LENGTH=7
GOJET_REDIRECT_TYPE=302
GOJET_ALLOW_REGISTRATION=true
GOJET_REQUIRE_EMAIL_VERIFICATION=false
GOJET_ALLOW_ANONYMOUS=false
GOJET_LINK_CACHE_TTL=3600
GOJET_CLICK_RETENTION_DAYS=90
GOJET_IP_HASH_KEY=replace-with-64-character-random-secret
GOJET_BLOCK_PRIVATE_TARGETS=true
GOJET_DOMAIN_VERIFICATION_PREFIX=_gojet-verification
GOJET_CLOUDFLARE_ENABLED=false
GOJET_CLOUDFLARE_API_TOKEN=
GOJET_CLOUDFLARE_ZONE_ID=
GOJET_CLOUDFLARE_CUSTOM_HOSTNAME_FALLBACK_ORIGIN=

GOJET_HTTP_PORT=8080
GOJET_AUTO_MIGRATE=false

GOJET_ADMIN_NAME="GoJet Administrator"
GOJET_ADMIN_EMAIL=
GOJET_ADMIN_PASSWORD=
# Go Redirect Plane / durable analytics spool
GOJET_REDIRECT_PLANE_ENABLED=true
GOJET_REDIRECT_INTERNAL_TOKEN=change-me-with-a-long-random-secret
GOJET_REDIRECT_INTERNAL_URL=http://nginx
GOJET_CONTROL_PLANE_URL=http://nginx
GOJET_REDIRECT_HEALTH_URL=http://redirector:8081/healthz
GOJET_REDIRECT_CACHE_TTL_SECONDS=3600
GOJET_REDIRECT_SPOOL_DIR=/var/lib/gojet/spool
GOJET_ANALYTICS_ENABLED=true
GOJET_ANALYTICS_STORE_REFERRER_URL=true
