{
  "name": "gojet-v5-frontend",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:site": "pnpm --filter @gojet/site dev",
    "dev:workspace": "pnpm --filter @gojet/workspace dev",
    "dev:admin": "pnpm --filter @gojet/admin dev",
    "dev:docs": "pnpm --filter @gojet/docs dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:brand": "node scripts/verify-brand-foundation.mjs",
    "verify:ui": "node scripts/verify-design-system.mjs",
    "verify:shells": "node scripts/verify-shell-foundation.mjs",
    "verify:links": "node scripts/verify-p05-links.mjs",
    "verify:domains": "node scripts/verify-p06-domains.mjs",
    "verify:analytics": "node scripts/verify-p07-analytics.mjs",
    "verify:qr": "node scripts/verify-p08-qr.mjs",
    "verify:files": "node scripts/verify-p09-files.mjs",
    "verify:text": "node scripts/verify-p10-text.mjs",
    "verify:bio": "node scripts/verify-p11-bio.mjs",
    "test:shells": "playwright test -c playwright.shells.config.ts",
    "test:links": "playwright test -c playwright.links.config.ts",
    "test:domains": "playwright test -c playwright.domains.config.ts",
    "test:analytics": "playwright test -c playwright.analytics.config.ts",
    "test:qr": "playwright test -c playwright.qr.config.ts",
    "test:files": "playwright test -c playwright.files.config.ts",
    "test:text": "playwright test -c playwright.text.config.ts",
    "test:bio": "playwright test -c playwright.bio.config.ts",
    "check": "pnpm verify:brand && pnpm verify:ui && pnpm verify:shells && pnpm verify:links && pnpm verify:domains && pnpm verify:analytics && pnpm verify:qr && pnpm verify:files && pnpm verify:text && pnpm verify:bio && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "^5.9.0"
  }
}
